# ==============================================================================
# CodiceSconto Admin Frontend Environment Variables
# ==============================================================================

# URL of the unified backend service used for Next.js rewrites and SSR fetch calls.
# Evaluated at build time in next.config.mjs; missing in production is a hard error.
BACKEND_URL="http://localhost:4000"
# BACKEND_URL="https://coupons-site-backend.vercel.app"

# URL of the public storefront website
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_SITE_URL="https://coupons-site.vercel.app"

